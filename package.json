{
  "name": "dsh-gotofile",
  "version": "1.0.1",
  "description": "Turn-tail text report of the files this turn produced or modified, each with its full path; double-click a path to reveal it in the OS file manager",
  "type": "module",
  "main": "lib/index.js",
  "scripts": {
    "test": "node --test"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "docs",
    "test",
    "assets"
  ],
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "goto-file",
    "changed-files",
    "reveal-in-file-manager",
    "web-ui",
    "productivity"
  ],
  "license": "MIT",
  "author": "SouthernSibyl",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SouthernSibyl/dsh-gotofile.git"
  },
  "homepage": "https://github.com/SouthernSibyl/dsh-gotofile#readme",
  "bugs": {
    "url": "https://github.com/SouthernSibyl/dsh-gotofile/issues"
  },
  "engines": {
    "dsh": ">=0.1.7",
    "node": ">=22"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "compatibility": {
      "dshReleases": {
        "0.2.0-rc.2": "compatible"
      }
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": ">=0.1.7-rc.1 <0.2.0-0 || >=0.2.0-rc.1 <0.3.0-0",
    "@deepseek-ai/cordis": "^4.0.1-rc.1",
    "react": "^18.3.1"
  }
}
